<%- include('partials/head') %>
<body class="site">
<%- include('partials/public-header') %>
<main id="main">
  <section class="hero page-shell" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title">Your next visit, on one slip.</h1>
      <p class="hero-lede">Request an appointment with the Health Centre and follow it from the moment you ask to the doctor's notes after your visit.</p>
      <div class="hero-actions">
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
          <a class="button primary" href="/dashboard">Go to your dashboard</a>
          <% if (currentUser.role === 'patient') { %><a class="button secondary" href="/appointments/new">Request an appointment</a><% } %>
        <% } else { %>
          <a class="button primary" href="/login/patient">Patient sign in</a>
          <a class="button secondary" href="/register">Create a patient account</a>
        <% } %>
      </div>
    </div>

    <figure class="hero-slip" aria-labelledby="hero-slip-caption">
      <div class="slip slip-confirmed slip-demo" aria-hidden="true">
        <div class="slip-body">
          <div class="slip-head">
            <div><p class="slip-demo-title">Visit with Dr. Meera Rao</p><p class="slip-ref">Ref <span class="ref-code">4F7A21C9</span></p></div>
            <span class="stamp stamp-confirmed">Scheduled</span>
          </div>
          <ol class="progress"><li class="is-done">Requested</li><li class="is-done">Scheduled</li><li>Visit recorded</li></ol>
          <dl class="slip-facts"><div class="fact-wide"><dt>Your request</dt><dd>Sore throat and mild fever <span class="muted">(2 days)</span></dd></div></dl>
        </div>
        <div class="slip-stub"><span class="stub-weekday">Thu</span><span class="stub-day">26</span><span class="stub-month">Nov</span><span class="stub-time">10:30</span></div>
      </div>
      <figcaption id="hero-slip-caption">An example appointment slip. Yours updates as the centre schedules your visit and the doctor records it.</figcaption>
    </figure>
  </section>

  <section class="how-section" id="how-it-works" aria-labelledby="how-title">
    <div class="page-shell">
      <h2 id="how-title">From request to follow-up</h2>
      <ol class="steps-list">
        <li><h3>Tell us what's wrong</h3><p>Describe what you need help with and how to reach you. It takes about a minute.</p></li>
        <li><h3>The centre books you in</h3><p>An administrator assigns a doctor and a time that's free in their schedule.</p></li>
        <li><h3>See the doctor</h3><p>Your slip shows the doctor, the day and the time, in clinic time.</p></li>
        <li><h3>Keep the doctor's notes</h3><p>After the visit, tests, medicine and advice appear on the same slip.</p></li>
      </ol>
    </div>
  </section>

  <section class="audience page-shell" aria-label="Who it's for">
    <div class="audience-card">
      <h2>For students and staff</h2>
      <p>Create a patient account with your email, or continue with Google. Turn on two-factor authentication to keep your health information private.</p>
      <p><a class="button primary" href="<%= typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'patient' ? '/appointments/new' : '/register' %>"><%= typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'patient' ? 'Request an appointment' : 'Create a patient account' %></a></p>
    </div>
    <div class="audience-card audience-card-staff">
      <h2>For the care team</h2>
      <p>Doctors see the day's visits and record outcomes. Administrators run the scheduling desk with open slots, accounts and an audit trail. Staff sign-in requires two-factor authentication.</p>
      <p class="staff-links"><a href="/login/doctor">Doctor sign in</a><a href="/login/admin">Administrator sign in</a></p>
    </div>
  </section>
</main>
<%- include('partials/footer') %>
</body>
</html>
