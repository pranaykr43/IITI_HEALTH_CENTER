<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · reliable care coordination</title>
  <link rel="stylesheet" href="/app.css">
</head>
<body>
  <header class="site-header">
    <a class="brand" href="/">Health Centre<span class="brand-dot">.</span></a>
    <nav aria-label="Primary navigation">
      <% if (currentUser) { %>
        <a href="/dashboard">Dashboard</a>
      <% } else { %>
        <a href="/login">Sign in</a>
      <% } %>
    </nav>
  </header>

  <main class="shell home-main">
    <section class="home-intro">
      <p class="eyebrow">IITI Health Centre</p>
      <h1>Care coordination, made clear.</h1>
      <p class="lede">Book care, manage consultations, and coordinate appointments through one secure Health Centre workspace.</p>
    </section>
    <section class="home-role-grid" aria-label="Choose your Health Centre portal">
      <article class="panel role-card patient-card">
        <span class="role-icon" aria-hidden="true">+</span>
        <p class="eyebrow">For patients</p>
        <h2>Patient Portal</h2>
        <p>Book appointments, check appointment status, and access your prescriptions.</p>
        <div class="role-actions"><a class="button primary" href="/login/patient">Patient Sign In</a><a href="/register">Create a patient account</a></div>
      </article>
      <article class="panel role-card">
        <span class="role-icon doctor-icon" aria-hidden="true">✚</span>
        <p class="eyebrow">For care providers</p>
        <h2>Doctor Portal</h2>
        <p>View assigned appointments, manage consultations, and record prescriptions.</p>
        <div class="role-actions"><a class="button secondary" href="/login/doctor">Doctor Sign In</a><span class="muted">Accounts are provided by an administrator.</span></div>
      </article>
      <article class="panel role-card">
        <span class="role-icon admin-icon" aria-hidden="true">▦</span>
        <p class="eyebrow">For centre staff</p>
        <h2>Administrator Portal</h2>
        <p>Coordinate schedules, manage accounts, and oversee centre operations.</p>
        <div class="role-actions"><a class="button secondary" href="/login/admin">Administrator Sign In</a><span class="muted">Administrator access is provisioned securely.</span></div>
      </article>
    </section>
    <section class="home-assurance" aria-label="Service information">
      <strong>Private by design</strong><span>Each portal shows only the information and actions assigned to that role.</span>
      <a href="/readyz">Service status</a>
    </section>
  </main>

  <footer class="site-footer shell">
    <span>Local-first engineering showcase</span>
    <span><a href="/healthz">health</a> · <a href="/metrics">metrics</a></span>
  </footer>
</body>
</html>
