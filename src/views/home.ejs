<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="description" content="Health Centre appointment coordination for patients and care teams.">
  <title><%= title || 'Health Centre' %></title>
  <link rel="stylesheet" href="/app.css">
</head>
<body>
<header class="site-header"><div class="site-header-inner">
  <a class="brand" href="/">Health Centre</a>
  <nav class="site-nav" aria-label="Main navigation">
    <a href="#appointments">Appointments</a><a href="#how-it-works">How it works</a>
    <a href="/login">Staff sign in</a>
    <% if (currentUser) { %><a class="nav-action" href="/dashboard">My dashboard</a><% } else { %><a class="nav-action" href="/login/patient">Patient sign in</a><% } %>
  </nav>
</div></header>
<main>
  <section class="hero page-shell" aria-labelledby="hero-title">
    <div class="hero-copy">
      <h1 id="hero-title">Health Centre</h1>
      <p class="hero-lede">A clear next step for your care.</p>
      <p class="hero-body">Request an appointment, follow its status, and review visit details recorded by the care team—all in one place.</p>
      <div class="hero-actions">
        <% if (currentUser) { %>
          <a class="button primary" href="/dashboard">Go to your dashboard</a>
          <% if (currentUser.role === 'patient') { %><a class="button secondary" href="/appointments/new">Request an appointment</a><% } %>
        <% } else { %>
          <a class="button primary" href="/login/patient">Patient sign in</a>
          <a class="button secondary" href="/register">Create a patient account</a>
        <% } %>
      </div>
    </div>
    <aside class="status-register" aria-labelledby="status-title">
      <div class="register-heading"><h2 id="status-title">Appointment status</h2></div>
      <p class="register-intro">Follow each request from review through follow-up.</p>
      <ol class="status-list">
        <li><span class="status-mark status-requested" aria-hidden="true"></span><div><strong>Requested</strong><p>Waiting for an administrator to review.</p></div></li>
        <li><span class="status-mark status-confirmed" aria-hidden="true"></span><div><strong>Confirmed</strong><p>A doctor and appointment time are assigned.</p></div></li>
        <li><span class="status-mark status-completed" aria-hidden="true"></span><div><strong>Completed</strong><p>Visit details are available when recorded.</p></div></li>
        <li><span class="status-mark status-other" aria-hidden="true"></span><div><strong>Cancelled or declined</strong><p>The request will not proceed as scheduled.</p></div></li>
      </ol>
      <a class="text-link" href="#how-it-works">How appointments work <span aria-hidden="true">→</span></a>
    </aside>
  </section>

  <section class="how-section" id="how-it-works" aria-labelledby="how-title">
    <div class="page-shell">
      <div class="section-heading"><div><h2 id="how-title">From request to follow-up</h2></div><p>Patients and care team staff can see what has happened and what comes next.</p></div>
      <ol class="steps-list">
        <li><h3>Request an appointment</h3><p>Share your request and preferred contact details.</p></li>
        <li><h3>Review and schedule</h3><p>An administrator reviews the request, assigns a doctor, and schedules a time.</p></li>
        <li><h3>Record the visit</h3><p>The doctor marks the visit complete and records follow-up details.</p></li>
        <li><h3>Check your updates</h3><p>Sign in to see the latest status and details recorded for the visit.</p></li>
      </ol>
    </div>
  </section>

  <section class="patient-section page-shell" id="appointments" aria-labelledby="patient-title">
    <div class="patient-copy"><h2 id="patient-title">Appointments, kept together.</h2><p>Create a patient account to request an appointment and review coordination updates. Already registered? Sign in to continue.</p><div class="hero-actions"><a class="button primary" href="<%= currentUser && currentUser.role === 'patient' ? '/appointments/new' : '/register' %>"><%= currentUser && currentUser.role === 'patient' ? 'Request an appointment' : 'Create a patient account' %></a><a class="text-link" href="/login/patient">Patient sign in</a></div></div>
    <div class="patient-aside"><h3>In your account</h3><ul><li>Appointment requests and status</li><li>Scheduling details</li><li>Visit notes and follow-up recorded by staff</li></ul></div>
  </section>

  <section class="staff-section" id="for-staff" aria-labelledby="staff-title"><div class="page-shell staff-inner"><div><h2 id="staff-title">Care team access</h2><p>Sign in with your provisioned staff account to coordinate appointments and follow-up.</p></div><div class="staff-links"><a href="/login/doctor">Doctor sign in <span aria-hidden="true">→</span></a><a href="/login/admin">Administrator sign in <span aria-hidden="true">→</span></a></div></div></section>
</main>
<footer class="site-footer"><div class="site-footer-inner"><p>Health Centre</p><p>Independent academic demonstration; not affiliated with or endorsed by IIT Indore. Use fictional information only.</p></div></footer>
</body>
</html>
