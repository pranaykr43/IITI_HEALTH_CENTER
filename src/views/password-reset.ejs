<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %> · Health Centre</title><link rel="stylesheet" href="/app.css"></head>
<body><header class="site-header"><div class="site-header-inner"><a class="brand" href="/">IITI Health Centre</a><a class="text-link" href="/login">Return to sign in</a></div></header>
<main class="auth-layout"><section class="auth-intro"><p class="section-index">Account recovery</p><h1>Choose a new password.</h1><p>Set a new password for your account. You can then sign in with your updated credentials.</p></section><section class="auth-panel"><h2>Change password</h2>
  <% if (error) { %><div class="form-error" role="alert"><%= error %></div><% } %>
  <form method="post" action="/password/reset" class="form-stack"><input type="hidden" name="token" value="<%= token %>"><div class="field"><label for="password">New password</label><span class="field-hint">At least 12 characters</span><input id="password" name="password" type="password" autocomplete="new-password" minlength="12" maxlength="200" required></div><div class="field"><label for="confirmPassword">Confirm new password</label><input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" minlength="12" maxlength="200" required></div><button class="button primary" type="submit">Save new password</button></form>
</section></main><footer class="site-footer"><div class="site-footer-inner"><p><a href="/">IITI Health Centre</a></p><p>Local engineering showcase</p></div></footer></body></html>
