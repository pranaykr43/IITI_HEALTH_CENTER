<%- include('partials/head') %>
<body class="site">
<%- include('partials/public-header', { headerLink: { href: '/login', label: 'Return to sign in' } }) %>
<main id="main" class="auth-layout">
  <section class="auth-intro">
    <h1>Choose a new password.</h1>
    <p>Set a new password for your account. Every device signed in to your account will be signed out.</p>
  </section>
  <section class="auth-panel" aria-labelledby="reset-title">
    <h2 id="reset-title">Change password</h2>
    <%- include('partials/flash', { errorMessage: error }) %>
    <form method="post" action="/password/reset" class="form-stack">
      <input type="hidden" name="token" value="<%= token %>">
      <div class="field"><label for="password">New password</label><span class="field-hint">At least 12 characters</span><input id="password" name="password" type="password" autocomplete="new-password" minlength="12" maxlength="200" required></div>
      <div class="field"><label for="confirmPassword">Confirm new password</label><input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" minlength="12" maxlength="200" required></div>
      <button class="button primary" type="submit">Save new password</button>
    </form>
  </section>
</main>
<%- include('partials/footer') %>
</body>
</html>
