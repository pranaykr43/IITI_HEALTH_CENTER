<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Health Centre</title>
  <link rel="stylesheet" href="/app.css">
</head>
<body class="muted-background">
  <main class="shell narrow-shell">
    <a class="brand" href="/">Health Centre<span class="brand-dot">.</span></a>
    <section class="panel auth-panel">
      <p class="eyebrow">Account recovery</p>
      <h1>Choose a new password</h1>
      <% if (error) { %><div class="alert error" role="alert"><%= error %></div><% } %>
      <form method="post" action="/password/reset" class="stack">
        <input type="hidden" name="token" value="<%= token %>">
        <label for="password">New password</label>
        <input id="password" name="password" type="password" autocomplete="new-password" minlength="12" maxlength="200" required>
        <label for="confirmPassword">Confirm new password</label>
        <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" minlength="12" maxlength="200" required>
        <button class="button primary" type="submit">Change password</button>
      </form>
      <p class="hint"><a href="/login">Return to sign in</a></p>
    </section>
  </main>
</body>
</html>
