<%- include('partials/head') %>
<body class="app">
<%- include('partials/app-header', { activeNav: 'security' }) %>
  <main id="main" class="workspace security-shell">
    <%- include('partials/flash', { message: heading + '.' }) %>
    <div class="workspace-heading"><div><h1>Save your recovery codes</h1>
      <p class="lede">Each code signs you in once if you lose access to your authenticator app. Store them somewhere safe, such as a password manager. They will not be shown again.</p>
    </div></div>
    <section class="panel" aria-labelledby="codes-title">
      <h2 id="codes-title" class="sr-only">Recovery codes</h2>
      <ul class="recovery-codes" aria-label="Recovery codes">
        <% recoveryCodes.forEach((code) => { %><li><code><%= code %></code></li><% }) %>
      </ul>
      <p class="hint">Generating new codes later replaces all of these.</p>
      <a class="button primary" href="/dashboard">I have saved my codes</a>
    </section>
  </main>
<%- include('partials/footer') %>
</body>
</html>
