<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %> · Health Centre</title><link rel="stylesheet" href="/app.css"><script src="/auth.js" defer></script></head>
<body><header class="site-header"><div class="site-header-inner"><a class="brand" href="/">IITI Health Centre</a><a class="text-link" href="/login/patient">Patient sign in</a></div></header>
<main class="auth-layout"><section class="auth-intro"><p class="section-index">Patient account</p><h1>Start with a request.</h1><p>Create an account to request appointments and follow coordination updates in this local demonstration.</p></section>
  <section class="auth-panel" aria-labelledby="register-title"><h2 id="register-title">Create your account</h2>
    <% if (error) { %><div class="form-error" role="alert"><%= error %></div><% } %>
    <% if (googleEnabled) { %><a class="button secondary google-button" href="/auth/google" data-submit-state>Continue with Google</a><div class="auth-divider"><span>or register with email</span></div><% } %>
    <form method="post" action="/auth/register/patient" class="form-stack" data-auth-form>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field"><label for="name">Full name</label><input id="name" name="name" autocomplete="name" required maxlength="120" autofocus></div>
      <div class="field"><label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="email" required maxlength="320"></div>
      <div class="field"><label for="password">Create a password</label><span class="field-hint">At least 12 characters</span><div class="password-field"><input id="password" name="password" type="password" autocomplete="new-password" minlength="12" required maxlength="200"><button class="password-toggle" type="button" data-password-toggle="password" aria-label="Show password" aria-pressed="false">Show</button></div></div>
      <div class="field"><label for="confirmPassword">Confirm password</label><input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" minlength="12" required maxlength="200"></div>
      <button class="button primary" type="submit" data-submit-button><span class="button-label">Create patient account</span><span class="button-loading" hidden>Creating your account…</span></button>
    </form>
    <p class="auth-links"><span>Already registered?</span><a href="/login/patient">Patient sign in</a></p><p class="hero-note">Use fictional information. Do not enter real medical or personal details.</p>
  </section>
</main><footer class="site-footer"><div class="site-footer-inner"><p><a href="/">IITI Health Centre</a></p><p>Local engineering showcase · Not a live campus service</p></div></footer></body></html>
