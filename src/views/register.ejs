<%- include('partials/head') %>
<body class="site">
<%- include('partials/public-header', { headerLink: { href: '/login/patient', label: 'Patient sign in' } }) %>
<main id="main" class="auth-layout">
  <section class="auth-intro">
    <h1>Start with a request.</h1>
    <p>Create a patient account to request appointments, see when you're booked in, and keep the doctor's notes from each visit.</p>
  </section>
  <section class="auth-panel" aria-labelledby="register-title">
    <h2 id="register-title">Create your account</h2>
    <%- include('partials/flash', { errorMessage: error }) %>
    <% if (googleEnabled) { %><a class="button secondary google-button" href="/auth/google"><svg aria-hidden="true" viewBox="0 0 48 48" focusable="false"><path fill="#4285F4" d="M43.6 24.5c0-1.4-.1-2.8-.4-4.1H24v7.8h11a9.4 9.4 0 0 1-4.1 6.2v5.1h6.6c3.9-3.6 6.1-8.8 6.1-15Z"/><path fill="#34A853" d="M24 44c5.5 0 10.1-1.8 13.5-4.8l-6.6-5.1c-1.8 1.2-4 1.9-6.9 1.9-5.3 0-9.8-3.6-11.4-8.4H5.8v5.3A20 20 0 0 0 24 44Z"/><path fill="#FBBC05" d="M12.6 27.6a12 12 0 0 1 0-7.2v-5.3H5.8a20 20 0 0 0 0 17.8l6.8-5.3Z"/><path fill="#EA4335" d="M24 12c3 0 5.7 1 7.8 3.1l5.9-5.9C34.1 5.9 29.5 4 24 4A20 20 0 0 0 5.8 15.1l6.8 5.3C14.2 15.6 18.7 12 24 12Z"/></svg><span>Continue with Google</span></a><div class="auth-divider"><span>or register with email</span></div><% } %>
    <form method="post" action="/auth/register/patient" class="form-stack" data-auth-form>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field"><label for="name">Full name</label><input id="name" name="name" autocomplete="name" required maxlength="120" autofocus></div>
      <div class="field"><label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="email" required maxlength="320"></div>
      <div class="field"><label for="password">Create a password</label><span class="field-hint">At least 12 characters</span><div class="password-field"><input id="password" name="password" type="password" autocomplete="new-password" minlength="12" required maxlength="200"><button class="password-toggle" type="button" data-password-toggle="password" aria-label="Show password" aria-pressed="false">Show</button></div></div>
      <div class="field"><label for="confirmPassword">Confirm password</label><input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" minlength="12" required maxlength="200"></div>
      <button class="button primary" type="submit" data-submit-button><span class="button-label">Create patient account</span><span class="button-loading" hidden>Creating your account…</span></button>
    </form>
    <p class="auth-links"><span>Already registered?</span><a href="/login/patient">Patient sign in</a></p>
    <p class="fine-print">Use fictional information only; do not enter real medical or personal details.</p>
  </section>
</main>
<%- include('partials/footer') %>
</body>
</html>
