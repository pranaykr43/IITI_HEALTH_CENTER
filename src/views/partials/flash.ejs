<% if (typeof message !== 'undefined' && message) { %><div class="toast toast-success" role="status"><svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="m5 10.5 3 3 7-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg><span><%= message %></span></div><% } %>
<% if (typeof errorMessage !== 'undefined' && errorMessage) { %><div class="toast toast-error" role="alert"><svg viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M10 6v5m0 3h.01" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg><span><%= errorMessage %></span></div><% } %>
