<%- include('partials/head') %>
<body class="site">
<%- include('partials/public-header', { headerLink: { href: '/', label: 'Return home' } }) %>
<main id="main" class="content-shell narrow">
  <section class="panel error-page">
    <h1><%= error.message || 'Something went wrong' %></h1>
    <p>Go back and try again, or return to the home page. If it keeps happening, share this reference with the Health Centre team.</p>
    <p class="help-text">Reference: <code><%= error.requestId || (typeof requestId !== 'undefined' && requestId) || 'not available' %></code></p>
    <a class="button secondary" href="/">Return home</a>
  </section>
</main>
<%- include('partials/footer') %>
</body>
</html>
