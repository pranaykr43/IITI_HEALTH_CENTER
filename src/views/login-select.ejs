<%- include('partials/head') %>
<body class="site">
<%- include('partials/public-header', { headerLink: { href: '/', label: 'Return home' } }) %>
<main id="main" class="content-shell narrow">
  <div class="page-heading"><h1>Sign in to Health Centre</h1><p>Choose the sign-in page for your account.</p></div>
  <%- include('partials/flash', { message, errorMessage: error }) %>
  <div class="choice-grid">
    <section class="choice-card" aria-labelledby="patient-access-title">
      <h2 id="patient-access-title">Patients</h2>
      <p>Request appointments and follow them through to the doctor's notes.</p>
      <div class="role-actions"><a class="button primary" href="/login/patient">Patient sign in</a><a href="/register">Create a patient account</a></div>
    </section>
    <section class="choice-card" aria-labelledby="staff-access-title">
      <h2 id="staff-access-title">Care team</h2>
      <p>Use the account the Health Centre administrator created for you.</p>
      <div class="staff-links"><a href="/login/doctor">Doctor sign in</a><a href="/login/admin">Administrator sign in</a></div>
    </section>
  </div>
</main>
<%- include('partials/footer') %>
</body>
</html>
