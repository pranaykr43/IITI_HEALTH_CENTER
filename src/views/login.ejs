<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %> · Health Centre</title><link rel="stylesheet" href="/app.css"><script src="/auth.js" defer></script></head>
<body><header class="site-header"><div class="site-header-inner"><a class="brand" href="/">IITI Health Centre</a><a class="text-link" href="/login">All sign-in options</a></div></header>
<main class="auth-layout"><section class="auth-intro"><p class="section-index">Local demo</p><h1>Welcome back.</h1><p>Sign in to continue your appointment coordination workflow. This demonstration is not connected to a live campus service.</p></section>
  <section class="auth-panel" aria-labelledby="auth-title"><h2 id="auth-title"><%= roleInfo.label %> sign in</h2>
    <% if (message) { %><div class="form-success" role="status"><%= message %></div><% } %>
    <% if (error) { %><div class="form-error" role="alert"><%= error %></div><% } %>
    <% if (role === 'patient' && googleEnabled) { %><a class="button secondary google-button" href="/auth/google" data-submit-state>Continue with Google</a><div class="auth-divider"><span>or use your email</span></div><% } %>
    <form method="post" action="/auth/login/<%= role %>" class="form-stack" data-auth-form>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field"><label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="username" required maxlength="320" autofocus></div>
      <div class="field"><label for="password">Password</label><div class="password-field"><input id="password" name="password" type="password" autocomplete="current-password" required maxlength="200"><button class="password-toggle" type="button" data-password-toggle="password" aria-label="Show password" aria-pressed="false">Show</button></div></div>
      <button class="button primary" type="submit" data-submit-button><span class="button-label">Sign in as <%= roleInfo.label %></span><span class="button-loading" hidden>Signing in…</span></button>
    </form>
    <% if (role === 'patient') { %><p class="auth-links"><span>New here? <a href="/register">Create a patient account</a></span><a href="/password/forgot">Forgot password?</a></p><% } else { %><p class="auth-links"><a href="/password/forgot">Forgot password?</a></p><p class="help-text"><%= role === 'doctor' ? 'Doctor accounts are provisioned for the local demonstration.' : 'Administrator accounts are provisioned for the local demonstration.' %></p><% } %>
    <p class="hero-note">Use fictional information. Do not enter real medical or personal details.</p>
  </section>
</main><footer class="site-footer"><div class="site-footer-inner"><p><a href="/">IITI Health Centre</a></p><p>Local engineering showcase · Not a live campus service</p></div></footer></body></html>
