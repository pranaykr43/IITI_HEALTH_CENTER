<%- include('partials/head') %>
<body class="site">
<%- include('partials/public-header', { headerLink: { href: '/login', label: 'All sign-in options' } }) %>
<main id="main" class="auth-layout">
  <section class="auth-intro">
    <h1>Welcome back.</h1>
    <p><%= role === 'patient' ? 'Sign in to see your appointment slips, scheduled times and the notes from your visits.' : role === 'doctor' ? "Sign in to see today's visits and record what happened." : 'Sign in to run the scheduling desk, manage accounts and review the audit log.' %></p>
  </section>
  <section class="auth-panel" aria-labelledby="auth-title">
    <h2 id="auth-title"><%= roleInfo.label %> sign in</h2>
    <%- include('partials/flash', { message, errorMessage: error }) %>
    <% if (role === 'patient' && googleEnabled) { %><a class="button secondary google-button" href="/auth/google"><svg aria-hidden="true" viewBox="0 0 48 48" focusable="false"><path fill="#4285F4" d="M43.6 24.5c0-1.4-.1-2.8-.4-4.1H24v7.8h11a9.4 9.4 0 0 1-4.1 6.2v5.1h6.6c3.9-3.6 6.1-8.8 6.1-15Z"/><path fill="#34A853" d="M24 44c5.5 0 10.1-1.8 13.5-4.8l-6.6-5.1c-1.8 1.2-4 1.9-6.9 1.9-5.3 0-9.8-3.6-11.4-8.4H5.8v5.3A20 20 0 0 0 24 44Z"/><path fill="#FBBC05" d="M12.6 27.6a12 12 0 0 1 0-7.2v-5.3H5.8a20 20 0 0 0 0 17.8l6.8-5.3Z"/><path fill="#EA4335" d="M24 12c3 0 5.7 1 7.8 3.1l5.9-5.9C34.1 5.9 29.5 4 24 4A20 20 0 0 0 5.8 15.1l6.8 5.3C14.2 15.6 18.7 12 24 12Z"/></svg><span>Continue with Google</span></a><div class="auth-divider"><span>or use your email</span></div><% } %>
    <form method="post" action="/auth/login/<%= role %>" class="form-stack" data-auth-form>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field"><label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="username" required maxlength="320" autofocus></div>
      <div class="field"><label for="password">Password</label><div class="password-field"><input id="password" name="password" type="password" autocomplete="current-password" required maxlength="200"><button class="password-toggle" type="button" data-password-toggle="password" aria-label="Show password" aria-pressed="false">Show</button></div></div>
      <button class="button primary" type="submit" data-submit-button><span class="button-label">Sign in as <%= roleInfo.label %></span><span class="button-loading" hidden>Signing in…</span></button>
    </form>
    <% if (role === 'patient') { %><p class="auth-links"><span>New here? <a href="/register">Create a patient account</a></span><a href="/password/forgot">Forgot password?</a></p><% } else { %><p class="auth-links"><a href="/password/forgot">Forgot password?</a></p><p class="help-text"><%= role === 'doctor' ? 'Doctor access is provided by the Health Centre administrator.' : 'Administrator access is provided by the system owner.' %></p><% } %>
    <p class="fine-print">Use fictional information. Do not enter real medical or personal details.</p>
  </section>
</main>
<%- include('partials/footer') %>
</body>
</html>
