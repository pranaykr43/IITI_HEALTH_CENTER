<%- include('partials/head') %>
<body class="site">
<%- include('partials/public-header', { headerLink: { href: '/login', label: 'Return to sign in' } }) %>
<main id="main" class="auth-layout">
  <section class="auth-intro">
    <h1>Get back to your account.</h1>
    <p>Enter the email address associated with your account. The same response is shown whether or not an account matches.</p>
  </section>
  <section class="auth-panel" aria-labelledby="forgot-title">
    <h2 id="forgot-title">Request a reset link</h2>
    <% if (sent && emailEnabled) { %><div class="toast toast-success" role="status"><span>If an active account matches that address, a password reset email may arrive shortly. If no email arrives, contact the demonstration operator.</span></div><% } %>
    <% if (sent && !emailEnabled) { %><div class="toast toast-success" role="status"><span>Password reset email is not configured for this demonstration. No email was sent. Contact the demonstration operator for help.</span></div><% } %>
    <%- include('partials/flash', { errorMessage: error }) %>
    <% if (!sent) { %><form method="post" action="/password/forgot" class="form-stack"><div class="field"><label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="email" required maxlength="320"></div><button class="button primary" type="submit">Send reset link</button></form><% } %>
    <p class="fine-print">Use fictional information only.</p>
  </section>
</main>
<%- include('partials/footer') %>
</body>
</html>
