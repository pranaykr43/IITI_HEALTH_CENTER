<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title><%= title %> · Health Centre</title><link rel="stylesheet" href="/app.css"></head>
<body><header class="site-header"><div class="site-header-inner"><a class="brand" href="/">IITI Health Centre</a><a class="text-link" href="/login">Return to sign in</a></div></header>
<main class="auth-layout"><section class="auth-intro"><p class="section-index">Account recovery</p><h1>Get back to your account.</h1><p>Enter the email address associated with your account. This local demo uses its configured delivery adapter.</p></section><section class="auth-panel"><h2>Request a reset link</h2>
  <% if (sent) { %><div class="form-success" role="status">If an active account matches that address, a reset link will be sent using the configured delivery adapter.</div><% } %>
  <% if (error) { %><div class="form-error" role="alert"><%= error %></div><% } %>
  <% if (!sent) { %><form method="post" action="/password/forgot" class="form-stack"><div class="field"><label for="email">Email address</label><input id="email" name="email" type="email" autocomplete="email" required maxlength="320"></div><button class="button primary" type="submit">Send reset link</button></form><% } %>
  <p class="hero-note">Use fictional information. This is not a live campus account system.</p>
</section></main><footer class="site-footer"><div class="site-footer-inner"><p><a href="/">IITI Health Centre</a></p><p>Local engineering showcase</p></div></footer></body></html>
