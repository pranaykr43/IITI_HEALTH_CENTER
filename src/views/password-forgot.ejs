<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> · Health Centre</title>
  <link rel="stylesheet" href="/app.css">
</head>
<body class="muted-background">
  <main class="shell narrow-shell">
    <a class="brand" href="/">Health Centre<span class="brand-dot">.</span></a>
    <section class="panel auth-panel">
      <p class="eyebrow">Account recovery</p>
      <h1>Request a reset link</h1>
      <% if (sent) { %><div class="alert success" role="status">If an active account matches that address, a reset link will be sent using the configured delivery adapter.</div><% } %>
      <% if (error) { %><div class="alert error" role="alert"><%= error %></div><% } %>
      <% if (!sent) { %>
        <form method="post" action="/password/forgot" class="stack">
          <label for="email">Email</label>
          <input id="email" name="email" type="email" autocomplete="email" required maxlength="320">
          <button class="button primary" type="submit">Send reset link</button>
        </form>
      <% } %>
      <p class="hint"><a href="/login">Return to sign in</a></p>
    </section>
  </main>
</body>
</html>
