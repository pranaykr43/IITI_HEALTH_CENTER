<%- include('partials/head') %>
<body class="app">
<%- include('partials/app-header', { activeNav: 'new' }) %>
<main id="main" class="workspace"><div class="workspace-heading"><div><h1>Request an appointment</h1><p class="lede">Tell us what you need help with. An administrator assigns a doctor and a time, and your slip updates as soon as it's booked.</p></div></div>
  <section class="panel appointment-form"><p class="form-note">Use fictional information only. This independent academic demonstration is not affiliated with IIT Indore.</p>
    <%- include('partials/flash', { errorMessage: error }) %>
    <form method="post" action="/appointments" class="form-stack">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="idempotencyKey" value="<%= idempotencyKey %>">
      <fieldset class="form-section"><legend>Contact details</legend><div class="form-grid"><div class="field"><label for="phone">Phone number</label><input id="phone" name="phone" inputmode="tel" autocomplete="tel" required maxlength="24"></div><div class="field"><label for="age">Age</label><input id="age" name="age" type="number" min="0" max="130" required></div></div></fieldset>
      <fieldset class="form-section"><legend>What would you like help with?</legend><div class="form-grid"><div class="field field-full"><label for="symptoms">Brief description</label><textarea id="symptoms" name="symptoms" rows="5" maxlength="2000" required></textarea><span class="field-hint">Use a fictional description; do not include real health information.</span></div><div class="field"><label for="daysWithSymptoms">Days with symptoms</label><input id="daysWithSymptoms" name="daysWithSymptoms" type="number" min="0" max="3650" required></div></div></fieldset>
      <div class="form-actions"><button class="button primary" type="submit">Submit appointment request</button><a href="/dashboard">Cancel</a></div>
    </form>
  </section>
</main>
<%- include('partials/footer') %>
</body>
</html>
