<%- include('partials/head') %>
<body class="site">
<%- include('partials/public-header', { headerLink: { href: '/login', label: 'Cancel sign-in' } }) %>
<main id="main" class="auth-layout"><section class="auth-intro"><h1>One more step.</h1><p>Open your authenticator app and enter the current 6-digit code for Health Centre. If you no longer have your device, use one of your recovery codes.</p></section>
  <section class="auth-panel" aria-labelledby="mfa-title"><h2 id="mfa-title">Enter your code</h2>
    <%- include('partials/flash', { errorMessage: error }) %>
    <form method="post" action="/auth/mfa" class="form-stack" data-auth-form>
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="field"><label for="code">Authentication code</label><input id="code" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" placeholder="123456" aria-describedby="code-hint" autofocus><span class="field-hint" id="code-hint">6 digits. A new code appears every 30 seconds.</span></div>
      <button class="button primary" type="submit" data-submit-button><span class="button-label">Verify and sign in</span><span class="button-loading" hidden>Verifying…</span></button>
    </form>
    <details class="privileged-operation recovery-entry">
      <summary>Use a recovery code instead</summary>
      <form method="post" action="/auth/mfa" class="form-stack">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <div class="field"><label for="recoveryCode">Recovery code</label><input id="recoveryCode" name="recoveryCode" autocomplete="off" autocapitalize="none" spellcheck="false" maxlength="40" placeholder="abcde-fghij"></div>
        <button class="button secondary" type="submit">Sign in with recovery code</button>
      </form>
    </details>
    <% if (typeof attemptsRemaining === 'number') { %><p class="help-text"><%= attemptsRemaining %> attempt<%= attemptsRemaining === 1 ? '' : 's' %> remaining for this sign-in. Lost your device and codes? Contact the Health Centre administrator to reset two-factor authentication.</p><% } %>
  </section>
</main>
<%- include('partials/footer') %>
</body>
</html>
