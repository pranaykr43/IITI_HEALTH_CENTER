<%- include('partials/head') %>
<body class="app">
<%- include('partials/app-header', { activeNav: 'security' }) %>
  <main id="main" class="workspace security-shell">
    <%- include('partials/flash') %>
    <div class="workspace-heading"><div><h1>Two-factor authentication</h1>
      <p class="lede">Two-factor authentication asks for a code from an authenticator app on your phone after your password, so a stolen password alone cannot open your account.</p>
    </div></div>

    <% if (status.enabled) { %>
      <section class="panel" aria-labelledby="mfa-on-title">
        <div class="section-heading"><h2 id="mfa-on-title">Two-factor authentication is on</h2><span class="status-badge status-confirmed">On</span></div>
        <p>Enabled <%= formatDateTime(status.enabledAt) %>. <strong><%= status.recoveryCodesRemaining %></strong> unused recovery code<%= status.recoveryCodesRemaining === 1 ? '' : 's' %> remaining.</p>
        <div class="security-actions">
          <form method="post" action="/account/mfa/recovery-codes" class="form-stack compact-form">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <div class="field"><label for="regen-code">Current authentication code</label><input id="regen-code" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required></div>
            <button class="button secondary" type="submit">Create new recovery codes</button>
            <p class="hint">Your previous recovery codes stop working.</p>
          </form>
          <% if (!required) { %>
            <form method="post" action="/account/mfa/disable" class="form-stack compact-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="field"><label for="disable-code">Current authentication code</label><input id="disable-code" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required></div>
              <button class="button danger" type="submit">Turn off two-factor authentication</button>
            </form>
          <% } else { %>
            <p class="notice">Two-factor authentication is required for <%= currentUser.role === 'admin' ? 'administrator' : 'doctor' %> accounts and cannot be turned off. If you lose your device and recovery codes, ask an administrator to reset it.</p>
          <% } %>
        </div>
      </section>
    <% } else if (demoLocked) { %>
      <section class="panel" aria-labelledby="mfa-demo-title">
        <h2 id="mfa-demo-title">Not available on shared demo accounts</h2>
        <p class="section-note">This showcase publishes these sign-ins so anyone can explore it, so two-factor setup is turned off for them. <a href="/register">Register your own patient account</a> to try two-factor authentication end to end.</p>
      </section>
    <% } else { %>
      <section class="panel" aria-labelledby="mfa-setup-title">
        <div class="section-heading"><h2 id="mfa-setup-title">Set up two-factor authentication</h2><span class="status-badge status-requested"><%= required ? 'Required' : 'Off' %></span></div>
        <% if (required) { %><p class="notice">Two-factor authentication is required for <%= currentUser.role === 'admin' ? 'administrator' : 'doctor' %> accounts. Finish setup to continue to your dashboard.</p><% } %>
        <ol class="setup-steps">
          <li><strong>Install an authenticator app</strong> such as Google Authenticator, Microsoft Authenticator, 1Password, or Aegis.</li>
          <li>
            <strong>Scan this QR code</strong> with the app, or enter the setup key manually.
            <div class="mfa-setup-grid">
              <img class="mfa-qr" src="<%= setup.qrDataUri %>" alt="QR code to add Health Centre to your authenticator app" width="200" height="200">
              <div>
                <p class="field-hint">Setup key (time-based, 6 digits, 30 seconds)</p>
                <code class="mfa-secret" data-mfa-secret="<%= setup.secret %>"><%= setup.secretGroups %></code>
                <p class="field-hint">Account: <%= currentUser.email %></p>
              </div>
            </div>
          </li>
          <li>
            <strong>Enter the 6-digit code</strong> shown in the app to confirm.
            <form method="post" action="/account/mfa/enable" class="form-stack compact-form">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="field"><label for="enable-code">Authentication code</label><input id="enable-code" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" maxlength="6" required></div>
              <button class="button primary" type="submit">Turn on two-factor authentication</button>
            </form>
          </li>
        </ol>
        <p class="hint">After setup you will see ten single-use recovery codes. Turning it on signs you out on other devices.</p>
      </section>
    <% } %>
  </main>
<%- include('partials/footer') %>
</body>
</html>
