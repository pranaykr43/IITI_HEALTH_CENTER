NODE_ENV=production
DEMO_MODE=true
PORT=3000
HEALTH_DB_PATH=/var/lib/health/data/health-centre.sqlite
PUBLIC_HOST=demo.example.org
PUBLIC_BASE_URL=https://demo.example.org
COOKIE_SECURE=true
TRUST_PROXY_HOPS=1
SESSION_TTL_SECONDS=28800
LOG_LEVEL=info
CLINIC_TIMEZONE=Asia/Kolkata
APPOINTMENT_SLOT_MINUTES=15
# Required in production: encrypts TOTP two-factor secrets at rest. Generate once with
#   openssl rand -base64 32
# and back it up separately from the database; losing it forces every user to re-enrol.
MFA_ENCRYPTION_KEY=
# Doctors and administrators must enrol in two-factor authentication (default true in production).
STAFF_MFA_REQUIRED=true
# Required to scrape /metrics in production (generate 32+ random characters); unset hides /metrics.
METRICS_TOKEN=
BACKUP_HOST_DIR=/opt/health-centre/backups
BACKUP_RETENTION_DAYS=14
# Optional: configure both after verifying a sending domain with Resend.
RESEND_API_KEY=
EMAIL_FROM=
# Optional Google OAuth; configure both client values together and register this exact callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://demo.example.org/auth/google/callback
# Worker controls
NOTIFICATION_POLL_INTERVAL_MS=1000
NOTIFICATION_LEASE_MS=30000
NOTIFICATION_MAX_ATTEMPTS=5
NOTIFICATION_RETRY_BASE_MS=1000
NOTIFICATION_RETRY_MAX_MS=60000
